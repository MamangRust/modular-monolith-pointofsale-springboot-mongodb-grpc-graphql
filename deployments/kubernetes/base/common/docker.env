APP_ENV=docker

# ── MongoDB: each service connects to its own DB namespace on the shared
#    single-node replica set. Spring Data MongoDB reads <SVC>_DB_HOST/PORT/NAME. ──
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=example_mongo_pointofsale

USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=example_mongo_pointofsale

ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=example_mongo_pointofsale

MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=example_mongo_pointofsale

TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=example_mongo_pointofsale

CASHIER_DB_HOST=mongo
CASHIER_DB_PORT=27017
CASHIER_DB_NAME=example_mongo_pointofsale

CATEGORY_DB_HOST=mongo
CATEGORY_DB_PORT=27017
CATEGORY_DB_NAME=example_mongo_pointofsale

PRODUCT_DB_HOST=mongo
PRODUCT_DB_PORT=27017
PRODUCT_DB_NAME=example_mongo_pointofsale

ORDER_DB_HOST=mongo
ORDER_DB_PORT=27017
ORDER_DB_NAME=example_mongo_pointofsale

ORDER_ITEM_DB_HOST=mongo
ORDER_ITEM_DB_PORT=27017
ORDER_ITEM_DB_NAME=example_mongo_pointofsale

DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=example_mongo_pointofsale

REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_HOSTS=redis://:dragon_knight@redis-node-1:6379,redis://:dragon_knight@redis-node-2:6379,redis://:dragon_knight@redis-node-3:6379,redis://:dragon_knight@redis-node-4:6379,redis://:dragon_knight@redis-node-5:6379,redis://:dragon_knight@redis-node-6:6379
# NOTE: services read spring.data.redis.host/.port/.password (mapped from the
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD vars above). The legacy Quarkus
# QUARKUS_REDIS_HOSTS variable was removed — nothing in the codebase reads it.

REDIS_HOST_APIGATEWAY=redis-node-1
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=dragon_knight
REDIS_DB_APIGATEWAY=0

REDIS_HOST_AUTH=redis-node-1
REDIS_PORT_AUTH=6379
REDIS_PASSWORD_AUTH=dragon_knight
REDIS_DB_AUTH=1

REDIS_HOST_ROLE=redis-node-1
REDIS_PORT_ROLE=6379
REDIS_PASSWORD_ROLE=dragon_knight
REDIS_DB_ROLE=2

REDIS_HOST_MERCHANT=redis-node-1
REDIS_PORT_MERCHANT=6379
REDIS_PASSWORD_MERCHANT=dragon_knight
REDIS_DB_MERCHANT=3

REDIS_HOST_TRANSACTION=redis-node-1
REDIS_PORT_TRANSACTION=6379
REDIS_PASSWORD_TRANSACTION=dragon_knight
REDIS_DB_TRANSACTION=4

REDIS_HOST_CASHIER=redis-node-1
REDIS_PORT_CASHIER=6379
REDIS_PASSWORD_CASHIER=dragon_knight
REDIS_DB_CASHIER=5

REDIS_HOST_CATEGORY=redis-node-1
REDIS_PORT_CATEGORY=6379
REDIS_PASSWORD_CATEGORY=dragon_knight
REDIS_DB_CATEGORY=6

REDIS_HOST_PRODUCT=redis-node-1
REDIS_PORT_PRODUCT=6379
REDIS_PASSWORD_PRODUCT=dragon_knight
REDIS_DB_PRODUCT=7

REDIS_HOST_ORDER=redis-node-1
REDIS_PORT_ORDER=6379
