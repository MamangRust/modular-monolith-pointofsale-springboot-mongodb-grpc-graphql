DB_SEEDER=false
SECRET_KEY=yantopedia
DB_URL=mongodb://mongo:27017/example_mongo_pointofsale
KAFKA_BROKERS=kafka:9092
# Fase 14 (K-6, K-7): durability producer — acks=all + enable.idempotence=true.
KAFKA_ACKS=all
KAFKA_IDEMPOTENCE=true
APP_LOGGER=production
OTEL_ENDPOINT=otel-collector:4317

GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_USER_ADDR=user:50053
