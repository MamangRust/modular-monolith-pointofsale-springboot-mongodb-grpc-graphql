APP_ENV=docker

# ── MongoDB: each service connects to its own DB namespace on the shared
#    single-node replica set. Spring Data MongoDB reads <SVC>_DB_HOST/PORT/NAME. ──
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=example_mongo_pointofsale

USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=example_mongo_pointofsale

ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=example_mongo_pointofsale

MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=example_mongo_pointofsale

TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=example_mongo_pointofsale

CASHIER_DB_HOST=mongo
CASHIER_DB_PORT=27017
CASHIER_DB_NAME=example_mongo_pointofsale

CATEGORY_DB_HOST=mongo
CATEGORY_DB_PORT=27017
CATEGORY_DB_NAME=example_mongo_pointofsale

PRODUCT_DB_HOST=mongo
PRODUCT_DB_PORT=27017
PRODUCT_DB_NAME=example_mongo_pointofsale

ORDER_DB_HOST=mongo
ORDER_DB_PORT=27017
ORDER_DB_NAME=example_mongo_pointofsale

ORDER_ITEM_DB_HOST=mongo
ORDER_ITEM_DB_PORT=27017
ORDER_ITEM_DB_NAME=example_mongo_pointofsale

DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=example_mongo_pointofsale

REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
# Spring Boot Redis config: services read spring.data.redis.host / .port / .password
# (mapped from REDIS_HOST / REDIS_PORT / REDIS_PASSWORD). The legacy Quarkus
# QUARKUS_REDIS_HOSTS / QUARKUS_REDIS_CLIENT_TYPE variables were removed.

REDIS_HOST_APIGATEWAY=redis-node-1
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=dragon_knight
REDIS_DB_APIGATEWAY=0

